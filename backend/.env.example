# ─── CONFIGURACIÓN DEL BACKEND DELIVERYHUB ─────────────────────────────────
# Copiá este archivo a .env y completá los valores

# Puerto del servidor de la API (el panel frontend lo consume en esta dirección)
PORT=3001

# ── Nombres de los grupos de WhatsApp a monitorear ──────────────────────────
# Deben coincidir EXACTAMENTE con el nombre del grupo en WhatsApp
# (mayúsculas, tildes, espacios, todo importa)
GROUP_RESTAURANTES=Restaurantes y pedidos
GROUP_COMUNIDAD=Comunidad de repartidores

# ── Modo de operación ────────────────────────────────────────────────────────
# LOG_ONLY=true  → solo registra eventos, no procesa pedidos (Fase 1)
# LOG_ONLY=false → procesa y registra todo (Fase 2)
LOG_ONLY=true
